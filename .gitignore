# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ---------------------------------------------------------------------------
# 构建产物
# 注意：desktop/build/ 里放的是**打包配置**（spec/脚本/版本资源/说明），不是产物，
# 因此下面用 ! 把它重新纳入版本控制；真正的产物在 desktop/build/output/ 下。
# ---------------------------------------------------------------------------
build/
dist/
!desktop/build/
!desktop/build/**
desktop/build/output/

# ---------------------------------------------------------------------------
# 运行时数据：行情缓存 / 自有 CSV / 持仓与模拟盘账本（不随仓库同步）
# 只保留模板与示例文件，方便用户照着放自己的数据。
# ---------------------------------------------------------------------------
backend/data/*
!backend/data/README.md
!backend/data/*.example.*
!backend/data/csv/
backend/data/csv/*
!backend/data/csv/**/
!backend/data/csv/**/*.example.csv

# ThinkRail 设计记录（临时产物，不进版本库；定稿内容会被写进 docs/ 与代码注释）
.thinkrail/context/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
